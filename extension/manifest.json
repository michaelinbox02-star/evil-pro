{
  "manifest_version": 3,
  "name": "Session Injector",
  "version": "2.2",
  "description": "Open a captured evilginx session in a window of your choosing, or paste cookies in. Never disturbs your own logins unless you ask it to.",
  "key": "",
  "minimum_chrome_version": "110",
  "incognito": "spanning",
  "permissions": [
    "cookies",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Injector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "session-injector@evil-pro.local",
      "strict_min_version": "115.0"
    }
  }
}
